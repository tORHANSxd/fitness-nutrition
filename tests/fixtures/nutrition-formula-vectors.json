    {
      "id": "X10",
      "inputCase": "数学可行但自动目标<=1200kcal",
      "expectedState": "requires_review",
      "expectedCode": "LOW_ENERGY_POLICY_REVIEW",
      "note": "1200为产品复核阈值，不是通用安全线；不得自动抬到1200"
